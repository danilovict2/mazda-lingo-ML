{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lingo Puzzle Schema",
  "description": "Question bank and content structure",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Choice Question",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique question ID, e.g. 'choice-track-A-001'"
              },
              "type": {
                "const": "choice"
              },
              "track": {
                "type": "string",
                "enum": ["A", "B"],
                "description": "Track identifier"
              },
              "question": {
                "type": "string",
                "description": "Question text"
              },
              "choices": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "string"
                },
                "description": "Four answer choices"
              },
              "correct_choice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3,
                "description": "Index of correct answer (0-3)"
              },
              "explanation": {
                "type": "string",
                "description": "Brief explanation shown after answer"
              }
            },
            "required": [
              "id",
              "type",
              "track",
              "question",
              "choices",
              "correct_choice",
              "explanation"
            ]
          },
          {
            "type": "object",
            "title": "Speaking Question",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique question ID, e.g. 'speak-track-A-001'"
              },
              "type": {
                "const": "speaking"
              },
              "track": {
                "type": "string",
                "enum": ["A", "B"],
                "description": "Track identifier"
              },
              "prompt": {
                "type": "string",
                "description": "Instructions for what to read and how to emphasize"
              },
              "phrase": {
                "type": "string",
                "description": "The phrase to read"
              },
              "emphasis_instruction": {
                "type": "string",
                "description": "Which word(s) to emphasize, e.g. 'BANK (financial institution, not river)' or 'Present (as in gift, not attendance)'"
              },
              "reference_audio": {
                "type": "string",
                "description": "Path to reference pronunciation audio, e.g. 'audio/ref-track-A-001.wav'"
              },
              "stress_pattern": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string"
                    },
                    "expected_stress": {
                      "type": "string",
                      "enum": ["primary", "secondary", "unstressed"]
                    },
                    "is_target_emphasis": {
                      "type": "boolean",
                      "description": "True if this word should be emphasized"
                    }
                  },
                  "required": ["word", "expected_stress"]
                },
                "description": "Expected stress pattern for reference"
              },
              "explanation": {
                "type": "string",
                "description": "Brief explanation of why the emphasis matters"
              }
            },
            "required": [
              "id",
              "type",
              "track",
              "prompt",
              "phrase",
              "emphasis_instruction",
              "reference_audio",
              "stress_pattern",
              "explanation"
            ]
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": ["questions"]
}
